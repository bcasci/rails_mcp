#!/bin/sh
# Mechanical quality gate for agentic and human development. Runs standardrb on
# staged Ruby, the minitest suite, and the ADR-constraint greps. Blocks the
# commit on any failure. Cannot be bypassed without --no-verify, which the
# process-lock Claude hook denies.
#
# Pre-commit is the canonical gate; CI re-runs the same checks on push as
# defense-in-depth (bypassed hooks, amended commits, force-pushes).

set -e

# Run from the working-tree root so binstubs resolve in the main checkout or a
# git worktree the work happens in.
cd "$(git rev-parse --show-toplevel)" || exit 1

# standardrb on staged Ruby.
STAGED_RB=$(git diff --cached --name-only --diff-filter=ACM -- '*.rb' || true)
if [ -n "$STAGED_RB" ]; then
  echo "[pre-commit] standardrb: checking staged .rb files..."
  echo "$STAGED_RB" | xargs bundle exec standardrb
  echo "[pre-commit] standardrb: clean"
else
  echo "[pre-commit] standardrb: no staged .rb files, skipping"
fi

# ADR / credential / dynamic-dispatch constraint gate (SEC-04, SEC-05). The greps
# now live in the single shared `rake adr:check` task so the hook and CI run the
# identical check — no grep duplicated between them.
echo "[pre-commit] ADR constraints: running rake adr:check..."
bundle exec rake adr:check
echo "[pre-commit] ADR constraints: clean"

# Minitest suite — the regression gate.
echo "[pre-commit] Tests: running suite..."
bundle exec rake test
echo "[pre-commit] Tests: green"

echo "[pre-commit] All checks passed."
