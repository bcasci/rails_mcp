# frozen_string_literal: true

# rails_mcp initializer — APP-OWNED, yours to edit.
#
# One job: subscribe to the audit event and write your own audit row. The gem ships
# no audit sink — it is yours.
#
# The allow-list — the tools the AI may call — is NOT here. It lives in
# app/mcp/registered_tools.rb (RegisteredTools.all), the one place listing what the
# AI may call. McpController passes that list to MCP::Server per request. To expose a
# tool, add its class to that array; nothing is registered here.

# --- Audit seam: subscribe and write an audit row --------------------------
# The gem publishes exactly one "invoke.rails_mcp" event per tool call and persists
# nothing. Subscribe here and write your own audit record so the log answers "which
# human ran this". The payload is { user:, tool:, args:, result: OR error: } and
# never contains a bearer token or credential.
#
# Replace the body with a write to your audit trail:
ActiveSupport::Notifications.subscribe("invoke.rails_mcp") do |*_args, payload|
  # McpAuditLog.create!(
  #   user: payload[:user],
  #   tool: payload[:tool],
  #   args: payload[:args],
  #   outcome: payload.key?(:error) ? "error" : "ok"
  # )
end
